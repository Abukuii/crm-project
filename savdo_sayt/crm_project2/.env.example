# ===================================
# DJANGO SOZLAMALARI
# ===================================
SECRET_KEY=django-insecure-BUNI-OZGARTIRING-uzun-random-kalit
DEBUG=False

# Sizning domeningiz (masalan: mijoz1.sizningsayt.com)
ALLOWED_HOSTS=sizningsayt.com,www.sizningsayt.com
DJANGO_ALLOWED_HOSTS=sizningsayt.com,www.sizningsayt.com

# SSL sozlamalari (production da True)
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True

# CSRF uchun domeningiz
CSRF_TRUSTED_ORIGINS=https://sizningsayt.com,https://www.sizningsayt.com

# ===================================
# POSTGRESQL BAZASI
# ===================================
DB_NAME=crm_db
DB_USER=postgres
DB_PASSWORD=KUCHLI_PAROL_YOZING
DB_HOST=db
DB_PORT=5432

# ===================================
# PORT (har bir mijoz uchun o'zgartiring)
# CRM 1: 8001
# CRM 2: 8002
# CRM 3: 8003 ... va h.k.
# ===================================
PORT=8001

# ===================================
# TELEGRAM BOT (ixtiyoriy)
# Bot konteynerini yoqish: docker compose --profile bot up -d
# ===================================
BOT_TOKEN=
# Savdo xabarlari yuboriladigan kanal: @kanal_nomi yoki -1001234567890
CHANNEL_ID=
# Hisobot oladigan adminlar (vergul bilan)
ADMIN_CHAT_IDS=
