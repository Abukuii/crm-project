# infra/.env — serverda yarating (git'ga qo'shilmaydi). Barcha qiymatlarni o'zgartiring.

# Domen va SSL
APP_DOMAIN=app.example.uz
ACME_EMAIL=admin@example.uz

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars
DJANGO_ALLOWED_HOSTS=app.example.uz
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.uz
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me-strong-password

# Docker image (CI'dan): ghcr.io/<owner>/qurilish-crm va versiya tegi
IMAGE_PREFIX=qurilish-crm
IMAGE_TAG=latest
