# infra/.env — serverda yaratiladi (git'ga QO'SHILMAYDI).
# setup-server.sh buni avtomatik to'ldiradi; qo'lda tahrirlash ham mumkin.

# ── Domen va SSL ─────────────────────────────────────────────────────────────
APP_DOMAIN=savdolarim.uz
ACME_EMAIL=admin@savdolarim.uz

# ── Django ───────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars
LOG_LEVEL=INFO
GUNICORN_WORKERS=3

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=savdo
POSTGRES_USER=savdo
POSTGRES_PASSWORD=change-me-strong-password

# ── Telegram (ixtiyoriy) ─────────────────────────────────────────────────────
# Savdo xabarlari uchun bot tokeni (har bir do'kon chat ID'ni Sozlamalarda kiritadi)
TELEGRAM_BOT_TOKEN=
# Deploy natijalari (yangilandi / xato) yuboriladigan chat ID
DEPLOY_TELEGRAM_CHAT_ID=

# ── Push bildirishnomalari (brauzer/telefon) ─────────────────────────────────
# setup-server.sh birinchi ishga tushirishda o'zi to'ldiradi.
# Qo'lda: docker compose run --rm api python manage.py generate_vapid_keys --env
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@savdolarim.uz

# ── Avtomatik yangilanish ────────────────────────────────────────────────────
# Server shu branch'ni kuzatadi (CI testlardan o'tgan commit'lar shu yerga tushadi)
DEPLOY_BRANCH=production

# ── Zaxira nusxa ─────────────────────────────────────────────────────────────
# Serverda nechta kunlik nusxa saqlansin
BACKUP_KEEP_DAYS=14
# AWS S3'ga ham yuborish uchun (ixtiyoriy): s3://bucket-nomi/savdo
# EC2 instance'ga S3'ga yozish huquqi bor IAM role biriktirilgan bo'lishi kerak
BACKUP_S3_URI=
