{
	email {$ACME_EMAIL}
}

# www.savdolarim.uz → savdolarim.uz
www.{$APP_DOMAIN} {
	redir https://{$APP_DOMAIN}{uri} permanent
}

{$APP_DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Excel import uchun (5 MB) + zaxira
	request_body {
		max_size 10MB
	}

	@backend path /api/* /admin/* /static/*
	handle @backend {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		# Hash'li fayllar — uzoq kesh; index.html — har doim yangi (yangilanish darhol ko'rinadi)
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@html path / /index.html
		header @html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
